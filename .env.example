# exploit-path-traversal — AI agent configuration
#
# Copy to `.env` in the directory you run the tool from, or export these
# in your shell. CLI flags override env; env overrides .env.
#
# The agent talks to any OpenAI-compatible /chat/completions endpoint.

# Base URL of the API (no trailing /chat/completions — just the root).
EPT_AI_BASE_URL=https://api.openai.com/v1

# Model identifier as your provider expects it.
EPT_AI_MODEL=gpt-4o-mini

# API key / bearer token.
EPT_AI_API_KEY=sk-...

# Optional tuning
# EPT_AI_TEMPERATURE=0
# EPT_AI_MAX_TOKENS=4096
# EPT_AI_TIMEOUT=60
# EPT_AI_BATCH_SIZE=40

# Generic OPENAI_* names are also accepted as fallbacks:
# OPENAI_BASE_URL=...
# OPENAI_API_KEY=...
# OPENAI_MODEL=...
